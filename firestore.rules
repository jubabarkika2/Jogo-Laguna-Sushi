rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) { 
      return id is string 
        && id.size() <= 128 
        && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    
    function incoming() { 
      return request.resource.data; 
    }
    
    function existing() { 
      return resource.data; 
    }
    
    function isValidHighScore(data) {
      return data.keys().hasAll(['name', 'score', 'date'])
        && data.keys().size() <= 4
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 50
        && data.score is int
        && data.score >= 0
        && data.score <= 100000
        && data.date is string
        && data.date.size() <= 15
        && (!('isOrderCourier' in data) || data.isOrderCourier is bool);
    }

    match /highscores/{scoreId} {
      allow get: if true;
      allow list: if true;
      allow create: if isValidId(scoreId) && isValidHighScore(incoming());
      allow update, delete: if false;
    }
  }
}
